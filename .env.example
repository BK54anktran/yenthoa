# Copy to .env (Docker) or .env.local (npm run dev) and fill in. Never commit the real file.

# --- database
# Managed hosts (Vibe Host) inject DATABASE_URL and/or DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME for you.
# docker compose builds DATABASE_URL itself from MYSQL_PASSWORD; for npm run dev use:
# DATABASE_URL=mysql://root@127.0.0.1:3307/yenthoa_db   (npm run db:dev starts that database)
MYSQL_PASSWORD=change-me

# --- admin login: run `npm run admin:hash -- "your password"` and paste its three lines here
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- optional
# UPLOAD_DIR=data/uploads      where uploaded images are stored (the image sets /data/uploads; keep /data persistent)
# COOKIE_SECURE=true           force the Secure flag on the login cookie when TLS ends at a proxy that
#                              does not send X-Forwarded-Proto
